### 1. Register a fresh user
POST {{auth_url}}/auth/register
Content-Type: application/json

{
  "email": "{{test_email}}",
  "password": "{{test_password}}"
}

> {%
  if (response.status === 201) {
    client.global.set("user_id", response.body.id);
  }
%}

### 2. Login — capture token pair
POST {{auth_url}}/auth/login
Content-Type: application/json

{
  "email": "{{test_email}}",
  "password": "{{test_password}}"
}

> {%
  client.global.set("access_token",  response.body.access_token);
  client.global.set("refresh_token", response.body.refresh_token);
%}

### 3. Fetch JWKS — a downstream service would do this once and cache
GET {{auth_url}}/.well-known/jwks.json

### 4. Refresh — old refresh token gets revoked, new pair captured
POST {{auth_url}}/auth/refresh
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}"
}

> {%
  client.global.set("access_token",  response.body.access_token);
  client.global.set("refresh_token", response.body.refresh_token);
%}

### 5. Logout — revoke current refresh token
POST {{auth_url}}/auth/logout
Content-Type: application/json

{
  "refresh_token": "{{refresh_token}}"
}
